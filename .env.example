# CYVANTIS Platform Configuration

# Backend API Environment
SECRET_KEY=replace_with_a_secure_random_value
DATABASE_URL=sqlite:///./cyvantis.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Honeypot Integration
COWRIE_LOG_PATH=./data/cowrie.json
SIMULATION_MODE=true
SIMULATION_INTERVAL_SECONDS=3.0

# Threat Intelligence Enrichment APIs
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Storage & Backup Settings
BACKUP_DIR=./backups
RETENTION_DAYS=90
