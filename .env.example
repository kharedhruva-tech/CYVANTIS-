# CYVANTIS Platform Configuration
# Enterprise Gateway Intelligence & Security Nexus

# Backend API Security
SECRET_KEY=replace_with_a_secure_random_value_minimum_32_characters
DATABASE_URL=sqlite:///./cyvantis.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
CREDENTIAL_REDACTION_ENABLED=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost,http://127.0.0.1

# Cowrie Honeypot Integration & Real Log Ingestion
# Set SIMULATION_MODE=false to tail real cowrie.json and disable synthetic generation
COWRIE_LOG_PATH=./data/cowrie.json
SIMULATION_MODE=false
SIMULATION_INTERVAL_SECONDS=3.0

# Threat Intelligence Enrichment APIs (Optional, graceful degradation if empty)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# Storage & Backup Settings
BACKUP_DIR=./backups
RETENTION_DAYS=90
